<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: {
                            light: '#63a4ff',
                            DEFAULT: '#1976d2',
                            dark: '#004ba0',
                        },
                        secondary: {
                            light: '#ff5983',
                            DEFAULT: '#f50057',
                            dark: '#bb002f',
                        }
                    },
                    fontFamily: {
                        sans: ['Roboto', 'sans-serif'],
                    },
                    boxShadow: {
                        'elevation-1': '0 2px 1px -1px rgba(0,0,0,0.2), 0 1px 1px 0 rgba(0,0,0,0.14), 0 1px 3px 0 rgba(0,0,0,0.12)',
                        'elevation-2': '0 3px 1px -2px rgba(0,0,0,0.2), 0 2px 2px 0 rgba(0,0,0,0.14), 0 1px 5px 0 rgba(0,0,0,0.12)',
                        'elevation-4': '0 2px 4px -1px rgba(0,0,0,0.2), 0 4px 5px 0 rgba(0,0,0,0.14), 0 1px 10px 0 rgba(0,0,0,0.12)',
                        'elevation-8': '0 5px 5px -3px rgba(0,0,0,0.2), 0 8px 10px 1px rgba(0,0,0,0.14), 0 3px 14px 2px rgba(0,0,0,0.12)',
                    }
                },
            },
        }
    </script>
    <link rel="stylesheet" href="/css/admin.css">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <style>
        /* Additional styles for Tailwind integration */
        .material-ripple {
            position: relative;
            overflow: hidden;
            transform: translate3d(0, 0, 0);
        }

        .material-ripple:after {
            content: "";
            display: block;
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            pointer-events: none;
            background-image: radial-gradient(circle, #fff 10%, transparent 10.01%);
            background-repeat: no-repeat;
            background-position: 50%;
            transform: scale(10, 10);
            opacity: 0;
            transition: transform .4s, opacity 0.8s;
        }

        .material-ripple:active:after {
            transform: scale(0, 0);
            opacity: .3;
            transition: 0s;
        }
    </style>
</head>

<body class="bg-gray-50 text-gray-900 font-sans">
    <div class="app-container">
        <header class="top-navbar flex items-center px-4 bg-primary text-white">
            <button id="menu-toggle"
                class="btn btn-icon mr-4 material-ripple hover:bg-primary-dark rounded-full p-2 transition-colors duration-200">
                <i class="material-icons">menu</i>
            </button>
            <div class="top-navbar-title text-xl font-medium">Experiment Management Dashboard</div>
            <div class="flex items-center gap-4 ml-auto">
                <button id="schedule-experiment-btn"
                    class="btn btn-primary flex items-center gap-2 py-2 px-4 rounded-md bg-white text-primary hover:bg-gray-100 transition-colors duration-200 shadow-elevation-1">
                    <i class="material-icons text-sm">add</i>
                    <span class="font-medium text-sm">Schedule</span>
                </button>
                 <!-- Notifications? -->
                <button
                    class="btn btn-icon material-ripple hover:bg-primary-dark rounded-full p-2 transition-colors duration-200">
                    <i class="material-icons">notifications</i>
                </button>
                <!-- Modify this to check account settings. -->
                <button
                    class="btn btn-icon material-ripple hover:bg-primary-dark rounded-full p-2 transition-colors duration-200">
                    <i class="material-icons">account_circle</i>
                </button>
            </div>
        </header>

        <aside class="sidebar bg-white">
            <nav class="sidebar-menu py-2">
                <a href="/admin" 
                    class="sidebar-menu-item active flex items-center px-6 py-3 text-primary bg-blue-50 font-medium hover:bg-blue-50 transition-colors duration-200">
                    <i class="material-icons mr-4">dashboard</i>
                    Dashboard
                </a>
                <a href="/admin/experiments"
                    class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
                    <i class="material-icons mr-4">science</i>
                    Experiments
                </a>
                <a href="/admin/participants"
                    class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
                    <i class="material-icons mr-4">people</i>
                    Participants
                </a>
                <a href="/admin/tags" 
                    class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
                    <i class="material-icons mr-4">local_offer</i>
                    Tags
                </a>
                <a href="/admin/content"
                    class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
                    <i class="material-icons mr-4">video_library</i>
                    Content
                </a>
                <a href="/admin/settings"
                    class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
                    <i class="material-icons mr-4">settings</i>
                    Settings
                </a>
            </nav>
        </aside>

        <main class="main-content bg-gray-50">
            <div class="card bg-white rounded-lg shadow-elevation-1 mb-8">
                <div class="card-header py-5 px-6 flex items-center justify-between border-b border-gray-200">
                    <div class="card-title text-xl font-medium text-gray-800">Active Experiments</div>
                    <div class="flex items-center gap-3">
                        <button
                            class="btn btn-text flex items-center gap-1 text-primary hover:bg-blue-50 px-3 py-2 rounded-md transition-colors duration-200">
                            <i class="material-icons text-sm">filter_list</i>
                            <span class="font-medium text-sm">Filter</span>
                        </button>
                        <button
                            class="btn btn-text flex items-center gap-1 text-primary hover:bg-blue-50 px-3 py-2 rounded-md transition-colors duration-200">
                            <i class="material-icons text-sm">sort</i>
                            <span class="font-medium text-sm">Sort</span>
                        </button>
                    </div>
                </div>
                <div class="card-content p-0">
                    <div class="overflow-x-auto">
                        <table class="data-table w-full">
                            <thead>
                                <tr class="bg-gray-50 border-b border-gray-200">
                                    <th class="py-3 px-4 text-left">Experiment Name</th>
                                    <th class="py-3 px-4 text-left">Type</th>
                                    <th class="py-3 px-4 text-left">Status</th>
                                    <th class="py-3 px-4 text-left">Start Date</th>
                                    <th class="py-3 px-4 text-left">End Date</th>
                                    <th class="py-3 px-4 text-left">Created By</th>
                                    <th class="py-3 px-4 text-left">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (error) { %>
                                    <tr>
                                        <td colspan="7" class="py-4 px-6 text-center text-red-500"><%= error %></td>
                                    </tr>
                                <% } else if (experiments && experiments.length > 0) { %>
                                    <% experiments.forEach(function(exp) { %> 
                                        <tr class="border-b border-gray-200 hover:bg-gray-50">
                                            <td class="py-3 px-4"><%= exp.name %></td>
                                            <td class="py-3 px-4"><%= exp.type %></td>
                                            <td class="py-3 px-4">
                                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                                                    <%= exp.status === 'Running' || exp.status === 'active' ? 'bg-green-100 text-green-800' : 
                                                       exp.status === 'Completed' || exp.status === 'completed' ? 'bg-blue-100 text-blue-800' : 
                                                       'bg-yellow-100 text-yellow-800' %>">
                                                    <%= exp.status %>
                                                </span>
                                            </td>
                                            <td class="py-3 px-4"><%= exp.start_date || 'N/A' %></td>
                                            <td class="py-3 px-4"><%= exp.end_date || 'N/A' %></td>
                                            <td class="py-3 px-4"><%= exp.created_by_admin_username || 'N/A' %></td>
                                            <td class="py-3 px-4">
                                                <a href="/admin/results/<%= exp.experiment_id %>" class="text-indigo-600 hover:text-indigo-900 text-sm">View Results</a>
                                                <!-- Add other actions like Edit/Delete later -->
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-gray-500">No experiments found or unable to load experiments.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card bg-white rounded-lg shadow-elevation-1">
                <div class="card-header py-5 px-6 flex items-center justify-between border-b border-gray-200">
                    <div class="card-title text-xl font-medium text-gray-800">Completed Experiments</div>
                </div>
                <div class="card-content p-0">
                    <div class="overflow-x-auto">
                        <table class="data-table w-full">
                            <thead>
                                <tr class="bg-gray-50 border-b border-gray-200">
                                    <th
                                        class="py-4 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Name</th>
                                    <th
                                        class="py-4 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Type</th>
                                    <th
                                        class="py-4 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Status</th>
                                    <th
                                        class="py-4 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Start Date</th>
                                    <th
                                        class="py-4 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        End Date</th>
                                    <th
                                        class="py-4 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% const completedExperiments=experiments.filter(exp=> exp.status === 'Completed'); %>
                                    <% if (completedExperiments && completedExperiments.length> 0) { %>
                                        <% completedExperiments.forEach(exp=> { %>
                                            <tr class="hover:bg-gray-50 transition-colors duration-150">
                                                <td class="py-4 px-6 whitespace-nowrap font-medium text-gray-800">
                                                    <%= exp.name %>
                                                </td>
                                                <td class="py-4 px-6 whitespace-nowrap text-gray-600">
                                                    <%= exp.type %>
                                                </td>
                                                <td class="py-4 px-6 whitespace-nowrap">
                                                    <span
                                                        class="status-chip status-completed inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                                        <span class="h-2 w-2 mr-1.5 rounded-full bg-gray-400"></span>
                                                        <%= exp.status %>
                                                    </span>
                                                </td>
                                                <td class="py-4 px-6 whitespace-nowrap text-gray-600">
                                                    <%= exp.startDate %>
                                                </td>
                                                <td class="py-4 px-6 whitespace-nowrap text-gray-600">
                                                    <%= exp.endDate %>
                                                </td>
                                                <td class="py-4 px-6 whitespace-nowrap flex gap-3">
                                                    <a href="/admin/results/<%= exp.id %>"
                                                        class="btn btn-text text-primary hover:bg-blue-50 px-3 py-1 rounded text-sm transition-colors duration-200">View
                                                        Results</a>
                                                    <form action="/admin/download/<%= exp.id %>" method="POST"
                                                        class="inline">
                                                        <button type="submit"
                                                            class="btn btn-text text-primary hover:bg-blue-50 px-3 py-1 rounded text-sm transition-colors duration-200">Download</button>
                                                    </form>
                                                </td>
                                            </tr>
                                            <% }); %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="6" class="py-4 px-6 text-center text-gray-500">No
                                                            completed experiments found.</td>
                                                    </tr>
                                                    <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>

        <button id="mobile-add-btn"
            class="btn-fab bg-secondary text-white flex items-center justify-center shadow-elevation-8 transition-all duration-300 hover:shadow-lg hover:bg-secondary-dark focus:outline-none focus:ring-2 focus:ring-secondary focus:ring-offset-2">
            <i class="material-icons">add</i>
        </button>
    </div>

    <div id="schedule-modal"
        class="modal-overlay hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 transition-opacity duration-300">
        <div class="modal bg-white rounded-lg shadow-elevation-8 max-w-lg w-full max-h-[90vh] flex flex-col transform transition-transform duration-300 scale-95 opacity-0"
            id="modal-content">
            <div class="modal-header py-4 px-6 flex items-center justify-between border-b border-gray-200">
                <div class="modal-title text-xl font-medium text-gray-800">Schedule New Experiment</div>
                <button id="close-modal"
                    class="btn btn-icon text-gray-500 hover:bg-gray-100 rounded-full p-2 transition-colors duration-200">
                    <i class="material-icons">close</i>
                </button>
            </div>
            <form action="/admin/schedule" method="POST">
                <div class="modal-content p-6 overflow-y-auto">
                    <div class="form-group mb-5">
                        <label for="experimentName"
                            class="form-label block text-sm font-medium text-gray-700 mb-1">Experiment Name</label>
                        <input type="text" id="experimentName" name="experimentName"
                            class="form-control block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
                            required>
                    </div>
                    <div class="form-group mb-5">
                        <label for="experimentType"
                            class="form-label block text-sm font-medium text-gray-700 mb-1">Experiment Type</label>
                        <select id="experimentType" name="experimentType"
                            class="form-control block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary bg-white"
                            required>
                            <option value="A/B Test">A/B Test</option>
                            <option value="Survey">Survey</option>
                            <option value="Behavioral">Behavioral Observation</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <!-- A/B Test Variants Section (Conditional) -->
                    <div id="ab-variants-section" class="form-group mb-5 hidden">
                        <label class="form-label block text-sm font-medium text-gray-700 mb-2">A/B Test Variants</label>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label for="variantAName" class="text-xs text-gray-500">Variant A Name:</label>
                                <input type="text" id="variantAName" name="variantAName" class="form-control mt-1 block w-full px-2 py-1 border border-gray-300 rounded-md text-sm" placeholder="e.g., Control Group">
                            </div>
                            <div>
                                <label for="variantBName" class="text-xs text-gray-500">Variant B Name:</label>
                                <input type="text" id="variantBName" name="variantBName" class="form-control mt-1 block w-full px-2 py-1 border border-gray-300 rounded-md text-sm" placeholder="e.g., New Feature">
                            </div>
                        </div>
                         <p class="text-xs text-gray-500 mt-1">Participants will be split between these two variants.</p>
                    </div>
                    <!-- End A/B Test Variants Section -->

                    <div class="form-group mb-5">
                        <label for="description"
                            class="form-label block text-sm font-medium text-gray-700 mb-1">Description</label>
                        <textarea id="description" name="description" rows="3"
                            class="form-control block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"></textarea>
                    </div>
                    <div class="form-group mb-5">
                        <label for="participants" class="form-label block text-sm font-medium text-gray-700 mb-1">Number
                            of Participants</label>
                        <input type="number" id="participants" name="participants" class="form-control" required>
                    </div>

                    <div class="form-group mb-5">
                        <label for="surveyOptions"
                            class="form-label block text-sm font-medium text-gray-700 mb-1">Survey Options</label>
                        <input type="text" id="surveyOptions" name="surveyOptions" class="form-control"
                            placeholder="e.g., Free Response, Multiple Choice" required>
                    </div>

                    <div class="form-group mb-5">
                        <label for="behaviorNotes"
                            class="form-label block text-sm font-medium text-gray-700 mb-1">Behavior Notes</label>
                        <input type="text" id="behaviorNotes" name="behaviorNotes" class="form-control"
                            placeholder="Describe behavioral experiment if any">
                    </div>

                    <!-- Dynamic Survey Questions Section -->
                    <div class="form-group mb-5">
                        <label class="form-label block text-sm font-medium text-gray-700 mb-2">Survey Questions (Optional)</label>
                        <div id="survey-questions-container"></div>
                        <button type="button" id="add-question-btn" class="mt-2 btn btn-outline text-sm text-primary border-primary hover:bg-blue-50">
                            <i class="material-icons text-sm mr-1">add_circle_outline</i> Add Question
                        </button>
                    </div>
                    <!-- End Dynamic Survey Questions Section -->

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="form-group">
                            <label for="startDate" class="form-label block text-sm font-medium text-gray-700 mb-1">Start Date</label>
                            <div class="grid grid-cols-1 sm:grid-cols-[2fr_1fr] gap-2">
                                <input type="date" id="startDate" name="startDate"
                                    class="form-control block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary"
                                    required>
                                <input type="time" id="startTime" name="startTime"
                                    class="form-control block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary">
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="endDate" class="form-label block text-sm font-medium text-gray-700 mb-1">End Date</label>
                            <div class="grid grid-cols-1 sm:grid-cols-[2fr_1fr] gap-2">
                                <input type="date" id="endDate" name="endDate"
                                    class="form-control block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary">
                                <input type="time" id="endTime" name="endTime"
                                    class="form-control block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-primary">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-3 px-6 flex items-center justify-end gap-3 border-t border-gray-200">
                    <button type="button" id="cancel-schedule"
                        class="btn btn-text px-4 py-2 text-gray-700 hover:bg-gray-100 rounded transition-colors duration-200">Cancel</button>
                    <button type="submit"
                        class="btn btn-primary px-4 py-2 bg-primary text-white hover:bg-primary-dark rounded shadow transition-colors duration-200">Schedule</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // DOM Elements for general modal and sidebar
        const menuToggle = document.getElementById('menu-toggle');
        const sidebar = document.querySelector('.sidebar');
        const mainContent = document.querySelector('.main-content');
        const scheduleBtn = document.getElementById('schedule-experiment-btn');
        const mobileAddBtn = document.getElementById('mobile-add-btn');
        const scheduleModal = document.getElementById('schedule-modal');
        const modalContent = document.getElementById('modal-content');
        const closeModalBtn = document.getElementById('close-modal');
        const cancelScheduleBtn = document.getElementById('cancel-schedule');

        // Toggle sidebar visibility
        menuToggle.addEventListener('click', () => {
            sidebar.classList.toggle('sidebar-hidden');
            mainContent.classList.toggle('main-content-full');
        });

        // Show modal with animation
        function showModal() {
            scheduleModal.classList.remove('hidden');
            setTimeout(() => {
                modalContent.classList.remove('scale-95', 'opacity-0');
                modalContent.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        // Hide modal with animation
        function hideModal() {
            modalContent.classList.remove('scale-100', 'opacity-100');
            modalContent.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                scheduleModal.classList.add('hidden');
            }, 300);
        }

        // Event listeners for modal
        scheduleBtn.addEventListener('click', showModal);
        mobileAddBtn.addEventListener('click', showModal);
        closeModalBtn.addEventListener('click', hideModal);
        cancelScheduleBtn.addEventListener('click', hideModal);
        scheduleModal.addEventListener('click', (e) => {
            if (e.target === scheduleModal) hideModal();
        });

        // --- A/B Test Variant UI Toggle ---
        const experimentTypeSelect = document.getElementById('experimentType');
        const abVariantsSection = document.getElementById('ab-variants-section');
        const variantANameInput = document.getElementById('variantAName');
        const variantBNameInput = document.getElementById('variantBName');

        if (experimentTypeSelect) { // Ensure the element exists
            experimentTypeSelect.addEventListener('change', (event) => {
                if (abVariantsSection && variantANameInput && variantBNameInput) { // Check dependent elements
                    if (event.target.value === 'A/B Test') {
                        abVariantsSection.classList.remove('hidden');
                        variantANameInput.required = true;
                        variantBNameInput.required = true;
                    } else {
                        abVariantsSection.classList.add('hidden');
                        variantANameInput.required = false;
                        variantBNameInput.required = false;
                    }
                }
            });
            // Trigger change on load in case A/B Test is pre-selected (e.g. form validation error)
             if(experimentTypeSelect.value === 'A/B Test'){
                abVariantsSection.classList.remove('hidden');
                variantANameInput.required = true;
                variantBNameInput.required = true;
            }
        }

        // --- JavaScript for Dynamic Questions ---
        const questionsContainer = document.getElementById('survey-questions-container');
        const addQuestionBtn = document.getElementById('add-question-btn');
        let questionIndex = 0;

        if (addQuestionBtn && questionsContainer) { // Ensure elements exist
            addQuestionBtn.addEventListener('click', () => {
                questionIndex++;
                const questionId = `question-${questionIndex}`;
                const questionDiv = document.createElement('div');
                questionDiv.classList.add('question-block', 'p-3', 'border', 'border-gray-200', 'rounded-md', 'mb-3', 'bg-gray-50');
                questionDiv.setAttribute('data-id', questionId);

                questionDiv.innerHTML = `
                    <div class="flex justify-between items-center mb-2">
                        <label class="text-sm font-medium text-gray-600">Question ${questionIndex}</label>
                        <button type="button" class="remove-question-btn text-red-500 hover:text-red-700 text-sm">&times; Remove</button>
                    </div>
                    <div class="form-group mb-2">
                        <label for="${questionId}-text" class="text-xs text-gray-500">Question Text:</label>
                        <input type="text" id="${questionId}-text" name="questions[${questionIndex-1}][text]" class="form-control mt-1 block w-full px-2 py-1 border border-gray-300 rounded-md text-sm" required>
                    </div>
                    <div class="form-group mb-2">
                        <label for="${questionId}-type" class="text-xs text-gray-500">Type:</label>
                        <select id="${questionId}-type" name="questions[${questionIndex-1}][type]" class="question-type-select form-control mt-1 block w-full px-2 py-1 border border-gray-300 rounded-md bg-white text-sm">
                            <option value="free_text">Free Text</option>
                            <option value="multiple_choice">Multiple Choice</option>
                            <option value="slider">Slider</option>
                        </select>
                    </div>
                    <div id="${questionId}-options-container" class="form-group mb-2 hidden">
                        <label for="${questionId}-options" class="text-xs text-gray-500">Options (comma-separated):</label>
                        <input type="text" id="${questionId}-options" name="questions[${questionIndex-1}][options]" class="form-control mt-1 block w-full px-2 py-1 border border-gray-300 rounded-md text-sm">
                    </div>
                    <div id="${questionId}-slider-container" class="form-group mb-2 hidden grid grid-cols-3 gap-2">
                        <div>
                            <label for="${questionId}-slider-min" class="text-xs text-gray-500">Min:</label>
                            <input type="number" id="${questionId}-slider-min" name="questions[${questionIndex-1}][slider_min]" class="form-control mt-1 block w-full px-2 py-1 border border-gray-300 rounded-md text-sm" value="0">
                        </div>
                        <div>
                            <label for="${questionId}-slider-max" class="text-xs text-gray-500">Max:</label>
                            <input type="number" id="${questionId}-slider-max" name="questions[${questionIndex-1}][slider_max]" class="form-control mt-1 block w-full px-2 py-1 border border-gray-300 rounded-md text-sm" value="100">
                        </div>
                        <div>
                            <label for="${questionId}-slider-step" class="text-xs text-gray-500">Step:</label>
                            <input type="number" id="${questionId}-slider-step" name="questions[${questionIndex-1}][slider_step]" class="form-control mt-1 block w-full px-2 py-1 border border-gray-300 rounded-md text-sm" value="1">
                        </div>
                    </div>
                `;
                questionsContainer.appendChild(questionDiv);

                questionDiv.querySelector('.question-type-select').addEventListener('change', handleQuestionTypeChange);
                questionDiv.querySelector('.remove-question-btn').addEventListener('click', (e) => {
                    e.target.closest('.question-block').remove();
                });
            });
        }

        function handleQuestionTypeChange(event) {
            const selectedType = event.target.value;
            const questionBlock = event.target.closest('.question-block');
            const optionsContainer = questionBlock.querySelector('[id$="-options-container"]');
            const sliderContainer = questionBlock.querySelector('[id$="-slider-container"]');

            if(optionsContainer && sliderContainer){ // Ensure elements exist
                optionsContainer.classList.add('hidden');
                sliderContainer.classList.add('hidden');
                optionsContainer.querySelector('input').required = false;
                sliderContainer.querySelectorAll('input').forEach(input => input.required = false);

                if (selectedType === 'multiple_choice') {
                    optionsContainer.classList.remove('hidden');
                    optionsContainer.querySelector('input').required = true;
                } else if (selectedType === 'slider') {
                    sliderContainer.classList.remove('hidden');
                    sliderContainer.querySelectorAll('input').forEach(input => input.required = true);
                }
            }
        }
    </script>
</body>

</html>