<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              light: '#63a4ff',
              DEFAULT: '#1976d2',
              dark: '#004ba0',
            },
            secondary: {
              light: '#ff5983',
              DEFAULT: '#f50057',
              dark: '#bb002f',
            }
          },
          fontFamily: { sans: ['Roboto', 'sans-serif'] },
          boxShadow: {
            'elevation-1': '0 2px 1px -1px rgba(0,0,0,0.2), 0 1px 1px 0 rgba(0,0,0,0.14), 0 1px 3px 0 rgba(0,0,0,0.12)',
            'elevation-2': '0 3px 1px -2px rgba(0,0,0,0.2), 0 2px 2px 0 rgba(0,0,0,0.14), 0 1px 5px 0 rgba(0,0,0,0.12)',
            'elevation-4': '0 2px 4px -1px rgba(0,0,0,0.2), 0 4px 5px 0 rgba(0,0,0,0.14), 0 1px 10px 0 rgba(0,0,0,0.12)',
            'elevation-8': '0 5px 5px -3px rgba(0,0,0,0.2), 0 8px 10px 1px rgba(0,0,0,0.14), 0 3px 14px 2px rgba(0,0,0,0.12)',
          }
        },
      },
    }
  </script>
  <link rel="stylesheet" href="/css/admin.css">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
</head>
<body class="bg-gray-50 text-gray-900 font-sans">
  <div class="app-container">
    <header class="top-navbar flex items-center px-4 bg-primary text-white">
      <button id="menu-toggle" class="btn btn-icon mr-4 material-ripple hover:bg-primary-dark rounded-full p-2 transition-colors duration-200">
        <i class="material-icons">menu</i>
      </button>
      <div class="top-navbar-title text-xl font-medium">Tag Management Dashboard</div>
    </header>

    <aside class="sidebar bg-white">
      <nav class="sidebar-menu py-2">
        <a href="/admin" class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
          <i class="material-icons mr-4">dashboard</i> Dashboard
        </a>
        <a href="/admin/experiments" class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
          <i class="material-icons mr-4">science</i> Experiments
        </a>
        <a href="/admin/participants" class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
          <i class="material-icons mr-4">people</i> Participants
        </a>
        <a href="/admin/tags" class="sidebar-menu-item active flex items-center px-6 py-3 text-primary bg-blue-50 font-medium hover:bg-blue-50 transition-colors duration-200">
          <i class="material-icons mr-4">local_offer</i> Tags
        </a>
        <a href="/admin/content" class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
          <i class="material-icons mr-4">video_library</i> Content
        </a>
        <a href="/admin/settings" class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
          <i class="material-icons mr-4">settings</i> Settings
        </a>
      </nav>
    </aside>

    <main class="main-content bg-gray-50 py-10 px-6">
      <% const totalTags = tags ? tags.length : 0; %>
      <% const tagsInUse = tags ? tags.filter(t => Number(t.usage_count || 0) > 0).length : 0; %>
      <% const totalAssignments = tags ? tags.reduce((sum, t) => sum + Number(t.usage_count || 0), 0) : 0; %>

      <% if (message) { %>
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6" role="alert">
          <span class="block sm:inline"><%= message %></span>
        </div>
      <% } %>
      <% if (error) { %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6" role="alert">
          <span class="block sm:inline"><%= error %></span>
        </div>
      <% } %>

      <!-- Stats -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="card bg-white rounded-lg shadow-elevation-1 p-6 flex items-center">
          <div class="w-10 h-10 rounded-md bg-blue-100 flex items-center justify-center">
            <i class="material-icons text-blue-600">local_offer</i>
          </div>
          <div class="ml-4">
            <p class="text-sm text-gray-500">Total Tags</p>
            <p class="text-2xl font-semibold text-gray-900"><%= totalTags %></p>
          </div>
        </div>
        <div class="card bg-white rounded-lg shadow-elevation-1 p-6 flex items-center">
          <div class="w-10 h-10 rounded-md bg-green-100 flex items-center justify-center">
            <i class="material-icons text-green-600">check_circle</i>
          </div>
          <div class="ml-4">
            <p class="text-sm text-gray-500">Tags In Use</p>
            <p class="text-2xl font-semibold text-gray-900"><%= tagsInUse %></p>
          </div>
        </div>
        <div class="card bg-white rounded-lg shadow-elevation-1 p-6 flex items-center">
          <div class="w-10 h-10 rounded-md bg-purple-100 flex items-center justify-center">
            <i class="material-icons text-purple-600">inventory</i>
          </div>
          <div class="ml-4">
            <p class="text-sm text-gray-500">Total Tag Assignments</p>
            <p class="text-2xl font-semibold text-gray-900"><%= totalAssignments %></p>
          </div>
        </div>
      </div>

      <!-- Tag list -->
      <div class="card bg-white rounded-lg shadow-elevation-1 mb-8">
        <div class="card-header py-5 px-6 flex items-center justify-between border-b border-gray-200">
          <div class="card-title text-xl font-medium text-gray-800">Tags</div>
          <button id="reset-btn" class="btn btn-text flex items-center gap-1 text-primary hover:bg-blue-50 px-3 py-2 rounded-md transition-colors duration-200">
            <i class="material-icons text-sm">refresh</i>
            <span class="font-medium text-sm">Reset form</span>
          </button>
        </div>
        <div class="card-content p-0">
          <div class="overflow-x-auto">
            <table class="data-table w-full min-w-max">
              <thead>
                <tr class="bg-gray-50 border-b border-gray-200">
                  <th class="py-3 px-4 text-left text-sm font-semibold text-gray-700">Name</th>
                  <th class="py-3 px-4 text-left text-sm font-semibold text-gray-700">Category</th>
                  <th class="py-3 px-4 text-left text-sm font-semibold text-gray-700">Description</th>
                  <th class="py-3 px-4 text-left text-sm font-semibold text-gray-700">Usage</th>
                  <th class="py-3 px-4 text-left text-sm font-semibold text-gray-700">Created</th>
                  <th class="py-3 px-4 text-left text-sm font-semibold text-gray-700">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <% if (tags && tags.length > 0) { %>
                  <% tags.forEach(function(tag) { %>
                    <tr class="hover:bg-gray-50 transition-colors">
                      <td class="py-3 px-4 text-sm text-gray-800 font-medium"><%= tag.tag_name %></td>
                      <td class="py-3 px-4 text-sm text-gray-700"><%= tag.tag_category || 'general' %></td>
                      <td class="py-3 px-4 text-sm text-gray-600"><%= tag.description || '—' %></td>
                      <td class="py-3 px-4 text-sm text-gray-700"><%= tag.usage_count || 0 %></td>
                      <td class="py-3 px-4 text-sm text-gray-600"><%= tag.created_at || 'N/A' %></td>
                      <td class="py-3 px-4 text-sm text-gray-700 flex items-center gap-3">
                        <a href="/admin/tags?tagId=<%= tag.tag_id %>" class="text-indigo-600 hover:text-indigo-800 font-medium text-xs">View content</a>
                        <button 
                          type="button" 
                          class="text-blue-600 hover:text-blue-800 font-medium text-xs" 
                          data-tag-id="<%= tag.tag_id %>"
                          data-tag-name="<%- tag.tag_name %>"
                          data-tag-category="<%- tag.tag_category || 'general' %>"
                          data-tag-description="<%- tag.description || '' %>"
                          onclick="startEdit(this)">
                          Edit
                        </button>
                        <form action="/admin/tags/<%= tag.tag_id %>/delete" method="POST" class="inline" onsubmit="return confirm('Delete this tag and remove it from all content?');">
                          <button type="submit" class="text-red-600 hover:text-red-800 font-medium text-xs">Delete</button>
                        </form>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="text-center py-4 text-gray-500">No tags defined yet.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Create / Edit tag -->
      <div class="card bg-white rounded-lg shadow-elevation-1 mb-8">
        <div class="card-header py-5 px-6 border-b border-gray-200">
          <div class="card-title text-xl font-medium text-gray-800">Create or Edit Tag</div>
        </div>
        <div class="card-content p-6">
          <form id="tag-form" action="/admin/tags/create" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <input type="hidden" id="tag-id" value="">
            <div class="flex flex-col">
              <label class="text-sm font-medium text-gray-700 mb-1" for="tag_name">Tag Name</label>
              <input required name="tag_name" id="tag_name" type="text" class="form-control px-3 py-2 border border-gray-300 rounded-md" placeholder="#pridemonth">
            </div>
            <div class="flex flex-col">
              <label class="text-sm font-medium text-gray-700 mb-1" for="tag_category">Category</label>
              <select name="tag_category" id="tag_category" class="form-control px-3 py-2 border border-gray-300 rounded-md">
                <option value="general">general</option>
                <option value="content_theme">content_theme</option>
                <option value="visual_element">visual_element</option>
                <option value="research_label">research_label</option>
              </select>
            </div>
            <div class="md:col-span-2 flex flex-col">
              <label class="text-sm font-medium text-gray-700 mb-1" for="description">Description</label>
              <textarea name="description" id="description" rows="3" class="form-control px-3 py-2 border border-gray-300 rounded-md" placeholder="Short description for admins"></textarea>
            </div>
            <div class="md:col-span-2 flex items-center gap-3">
              <button type="submit" class="btn btn-primary px-4 py-2 bg-primary text-white rounded hover:bg-primary-dark transition-colors">Save</button>
              <button type="button" id="cancel-edit" class="btn btn-secondary px-4 py-2 bg-gray-100 text-gray-800 rounded hover:bg-gray-200 transition-colors">Cancel</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Tagged content -->
      <div class="card bg-white rounded-lg shadow-elevation-1">
        <div class="card-header py-5 px-6 border-b border-gray-200 flex items-center justify-between">
          <div class="card-title text-xl font-medium text-gray-800">
            Content with selected tag
            <% if (selectedTagId) { %>
              <span class="text-sm text-gray-500 ml-2">(Tag ID: <%= selectedTagId %>)</span>
            <% } %>
          </div>
        </div>
        <div class="card-content p-6">
          <% if (selectedTagId && taggedContent && taggedContent.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              <% taggedContent.forEach(function(video) { %>
                <div class="border border-gray-200 rounded-lg p-4 shadow-elevation-1 bg-white">
                  <div class="flex items-center justify-between mb-2">
                    <div class="text-sm font-semibold text-gray-800"><%= video.caption || 'Untitled' %></div>
                    <span class="text-xs text-gray-500">ID: <%= video.id %></span>
                  </div>
                  <p class="text-xs text-gray-600 mb-2 truncate"><%= video.video_url %></p>
                  <div class="flex items-center justify-between text-xs text-gray-500">
                    <span>Duration: <%= video.duration_seconds || 'n/a' %></span>
                    <span>Uploaded: <%= video.uploaded_at || 'n/a' %></span>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else if (selectedTagId) { %>
            <p class="text-gray-600">No content currently uses this tag.</p>
          <% } else { %>
            <p class="text-gray-600">Select a tag to see the content it is applied to.</p>
          <% } %>
        </div>
      </div>
    </main>
  </div>

  <script>
    const menuToggle = document.getElementById('menu-toggle');
    const sidebar = document.querySelector('.sidebar');
    const mainContent = document.querySelector('.main-content');
    menuToggle.addEventListener('click', () => {
      sidebar.classList.toggle('sidebar-hidden');
      mainContent.classList.toggle('main-content-full');
    });

    const tagForm = document.getElementById('tag-form');
    const tagIdField = document.getElementById('tag-id');
    const nameField = document.getElementById('tag_name');
    const categoryField = document.getElementById('tag_category');
    const descriptionField = document.getElementById('description');
    const resetBtn = document.getElementById('reset-btn');
    const cancelBtn = document.getElementById('cancel-edit');

    function resetForm() {
      tagForm.action = '/admin/tags/create';
      tagIdField.value = '';
      nameField.value = '';
      categoryField.value = 'general';
      descriptionField.value = '';
    }

    function startEdit(btn) {
      const tagId = btn.getAttribute('data-tag-id');
      const tagName = btn.getAttribute('data-tag-name');
      const tagCategory = btn.getAttribute('data-tag-category');
      const tagDescription = btn.getAttribute('data-tag-description');

      tagForm.action = `/admin/tags/${tagId}/edit`;
      tagIdField.value = tagId;
      nameField.value = tagName || '';
      categoryField.value = tagCategory || 'general';
      descriptionField.value = tagDescription || '';
    }

    resetBtn?.addEventListener('click', resetForm);
    cancelBtn?.addEventListener('click', resetForm);
  </script>
</body>
</html>

