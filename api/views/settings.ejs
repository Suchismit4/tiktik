<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/admin.css">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
</head>

<body class="bg-gray-50 text-gray-900 font-sans">
<div class="app-container">

    <header class="top-navbar flex items-center px-4 bg-primary text-white">
        <button id="menu-toggle" class="btn btn-icon mr-4 material-ripple hover:bg-primary-dark rounded-full p-2 transition-colors duration-200">
            <i class="material-icons">menu</i>
        </button>
        <div class="top-navbar-title text-xl font-medium">Experiment Management Dashboard</div>
    </header>

    <aside class="sidebar bg-white">
        <nav class="sidebar-menu py-2">
            <a href="/admin" class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
                <i class="material-icons mr-4">dashboard</i> Dashboard
            </a>
            <a href="/admin/experiments" class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
                <i class="material-icons mr-4">science</i> Experiments
            </a>
            <a href="/admin/participants" class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
                <i class="material-icons mr-4">people</i> Participants
            </a>
            <a href="/admin/groups" class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
                <i class="material-icons mr-4">groups</i> Groups
            </a>
            <a href="/admin/content" class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
                <i class="material-icons mr-4">video_library</i> Content
            </a>
            <a href="/admin/settings" class="sidebar-menu-item active flex items-center px-6 py-3 text-primary bg-blue-50 font-medium hover:bg-blue-50 transition-colors duration-200">
                <i class="material-icons mr-4">settings</i> Settings
            </a>
        </nav>
    </aside>

    <main class="main-content bg-gray-50 flex flex-col items-center justify-center py-12">
        <div class="card bg-white rounded-lg shadow-elevation-1 p-8 w-full max-w-md">
            <h1 class="text-xl font-bold mb-6 text-center">Settings</h1>
            <div class="flex flex-col gap-4">
                <!-- Sign in with Google button -->
                <a href="/login/federated/google" 
                   class="flex items-center justify-center gap-2 w-full py-2 border border-gray-300 rounded text-gray-700 font-medium hover:bg-gray-100 transition duration-200">
                    <img src="https://www.google.com/favicon.ico" alt="Google" class="w-5 h-5">
                    Sign in with Google
                </a>

                <!-- Optional buttons (disabled or linked to your routes) -->
                <form action="/logout" method="post">
                    <button type="submit" 
                            class="btn btn-secondary w-full py-2 rounded hover:bg-gray-200 transition duration-200">
                        Log Out
                    </button>
                </form>
            </div>
        </div>
    </main>
</div>

<script>
    const menuToggle = document.getElementById('menu-toggle');
    const sidebar = document.querySelector('.sidebar');
    const mainContent = document.querySelector('.main-content');
    menuToggle.addEventListener('click', () => {
        sidebar.classList.toggle('sidebar-hidden');
        mainContent.classList.toggle('main-content-full');
    });
</script>

</body>
</html>
