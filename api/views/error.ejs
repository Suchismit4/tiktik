<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/admin.css"> 
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background-color: #f3f4f6; /* bg-gray-100 */
            font-family: 'Roboto', sans-serif;
        }
        .error-container {
            text-align: center;
            background-color: white;
            padding: 2rem 3rem;
            border-radius: 0.5rem;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }
        .error-code {
            font-size: 3rem;
            font-weight: bold;
            color: #ef4444; /* text-red-500 */
        }
        .error-message {
            font-size: 1.25rem;
            color: #374151; /* text-gray-700 */
            margin-top: 0.5rem;
            margin-bottom: 1.5rem;
        }
        .home-link {
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background-color: #1976d2; /* primary.DEFAULT from your Tailwind config */
            color: white;
            text-decoration: none;
            border-radius: 0.375rem;
            transition: background-color 0.3s;
        }
        .home-link:hover {
            background-color: #004ba0; /* primary.dark */
        }
    </style>
</head>
<body>
    <div class="error-container">
        <div class="error-code"><%= locals.status || 'Error' %></div>
        <h1 class="text-2xl font-semibold text-gray-800 mt-4"><%= title %></h1>
        <p class="error-message"><%= message %></p>
        <a href="/admin" class="home-link">Go to Dashboard</a>
    </div>
</body>
</html> 