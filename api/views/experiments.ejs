<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/admin.css">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
</head>

<body class="bg-gray-50 text-gray-900 font-sans">
<div class="app-container">

  <header class="top-navbar flex items-center px-4 bg-primary text-white">
    <button id="menu-toggle" class="btn btn-icon mr-4 material-ripple hover:bg-primary-dark rounded-full p-2 transition-colors duration-200">
      <i class="material-icons">menu</i>
    </button>
    <div class="top-navbar-title text-xl font-medium">Experiment Management Dashboard</div>
  </header>

  <aside class="sidebar bg-white">
    <nav class="sidebar-menu py-2">
      <a href="/admin" class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
        <i class="material-icons mr-4">dashboard</i> Dashboard
      </a>
      <a href="/admin/experiments" class="sidebar-menu-item active flex items-center px-6 py-3 text-primary bg-blue-50 font-medium hover:bg-blue-50 transition-colors duration-200">
        <i class="material-icons mr-4">science</i> Experiments
      </a>
      <a href="/admin/participants" class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
        <i class="material-icons mr-4">people</i> Participants
      </a>
      <a href="/admin/groups" class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
        <i class="material-icons mr-4">groups</i> Groups
      </a>
      <a href="/admin/content" class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
        <i class="material-icons mr-4">video_library</i> Content
      </a>
      <a href="/admin/settings" class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
        <i class="material-icons mr-4">settings</i> Settings
      </a>
    </nav>
  </aside>

  <main class="main-content bg-gray-50 py-10 px-6">

    <div class="card bg-white rounded-lg shadow-elevation-1">
      <div class="card-header py-5 px-6 flex items-center justify-between border-b border-gray-200">
        <div class="card-title text-xl font-medium text-gray-800">All Experiments</div>
      </div>
      <div class="card-content p-0">
        <div class="overflow-x-auto">
          <table class="data-table w-full min-w-max">
            <thead>
              <tr class="bg-gray-100 border-b border-gray-200">
                <th class="py-3 px-4 text-left text-sm font-semibold text-gray-700">Name</th>
                <th class="py-3 px-4 text-left text-sm font-semibold text-gray-700">Type</th>
                <th class="py-3 px-4 text-left text-sm font-semibold text-gray-700">Status</th>
                <th class="py-3 px-4 text-left text-sm font-semibold text-gray-700">Start Date</th>
                <th class="py-3 px-4 text-left text-sm font-semibold text-gray-700">End Date</th>
                <th class="py-3 px-4 text-left text-sm font-semibold text-gray-700">Created By</th>
                <th class="py-3 px-4 text-left text-sm font-semibold text-gray-700">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% if (error) { %>
                <tr>
                  <td colspan="7" class="py-4 px-6 text-center text-red-500"><%= error %></td>
                </tr>
              <% } else if (experiments && experiments.length > 0) { %>
                <% experiments.forEach(function(exp) { %>
                  <tr class="hover:bg-gray-50 transition-colors">
                    <td class="py-3 px-4 text-sm text-gray-700"><%= exp.name %></td>
                    <td class="py-3 px-4 text-sm text-gray-700"><%= exp.type %></td>
                    <td class="py-3 px-4 text-sm text-gray-700">
                      <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full 
                        <%= exp.status === 'Running' || exp.status === 'active' ? 'bg-green-100 text-green-800' : 
                           exp.status === 'Completed' || exp.status === 'completed' ? 'bg-blue-100 text-blue-800' : 
                           exp.status === 'planning' ? 'bg-yellow-100 text-yellow-800' :
                           'bg-gray-100 text-gray-800' %>">
                        <%= exp.status %>
                      </span>
                    </td>
                    <td class="py-3 px-4 text-sm text-gray-700"><%= exp.start_date || 'N/A' %></td>
                    <td class="py-3 px-4 text-sm text-gray-700"><%= exp.end_date || 'N/A' %></td>
                    <td class="py-3 px-4 text-sm text-gray-700"><%= exp.created_by_admin_username || 'N/A' %></td>
                    <td class="py-3 px-4 text-sm text-gray-700 flex items-center gap-2">
                      <a href="/admin/results/<%= exp.experiment_id %>" class="text-indigo-600 hover:text-indigo-800 font-medium">View Details</a>
                      <form action="/admin/experiments/<%= exp.experiment_id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to permanently delete this experiment and all its associated data?');" class="inline">
                        <button type="submit" class="text-red-600 hover:text-red-800 font-medium text-xs p-1 rounded hover:bg-red-50">Delete</button>
                      </form>
                      <!-- More actions like Edit can be added here -->
                      <!-- Example: <a href="/admin/experiments/edit/<%= exp.experiment_id %>" class="text-green-600 hover:text-green-800 ml-2 font-medium">Edit</a> -->
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center py-4 text-gray-500">No experiments found.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </main>
</div>

<script>
const menuToggle = document.getElementById('menu-toggle');
const sidebar = document.querySelector('.sidebar');
const mainContent = document.querySelector('.main-content');
menuToggle.addEventListener('click', () => {
  sidebar.classList.toggle('sidebar-hidden');
  mainContent.classList.toggle('main-content-full');
});
</script>

</body>
</html>
