<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/admin.css">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
</head>

<body class="bg-gray-50 text-gray-900 font-sans">
<div class="app-container">

  <header class="top-navbar flex items-center px-4 bg-primary text-white">
    <button id="menu-toggle" class="btn btn-icon mr-4 material-ripple hover:bg-primary-dark rounded-full p-2 transition-colors duration-200">
      <i class="material-icons">menu</i>
    </button>
    <div class="top-navbar-title text-xl font-medium">Experiment Management Dashboard</div>
  </header>

  <aside class="sidebar bg-white">
    <nav class="sidebar-menu py-2">
      <a href="/admin" class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
        <i class="material-icons mr-4">dashboard</i> Dashboard
      </a>
      <a href="/admin/experiments" class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
        <i class="material-icons mr-4">science</i> Experiments
      </a>
      <a href="/admin/participants" class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
        <i class="material-icons mr-4">people</i> Participants
      </a>
            <a href="/admin/tags" class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
                <i class="material-icons mr-4">local_offer</i> Tags
      </a>
      <!-- <a href="/admin/settings" class="sidebar-menu-item flex items-center px-6 py-3 text-gray-700 font-medium hover:bg-gray-50 transition-colors duration-200">
        <i class="material-icons mr-4">settings</i> Settings
      </a> -->
    </nav>
  </aside>

  <main class="main-content bg-gray-50 p-6">
    <% if (error) { %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-6" role="alert">
        <strong class="font-bold">Error!</strong>
        <span class="block sm:inline"><%= error %></span>
      </div>
    <% } %>

    <% if (experiment) { %>
      <div class="card bg-white rounded-lg shadow-elevation-1 mb-8">
        <div class="card-header py-5 px-6 border-b border-gray-200">
          <h1 class="text-2xl font-semibold text-gray-800"><%= experiment.name %></h1>
          <p class="text-sm text-gray-600">Type: <%= experiment.type %> | Status: <span class="font-medium <%= experiment.status === 'Running' || experiment.status === 'active' ? 'text-green-600' : experiment.status === 'Completed' || experiment.status === 'completed' ? 'text-blue-600' : 'text-yellow-600' %>"><%= experiment.status %></span></p>
        </div>
        <div class="card-content p-6">
          <h2 class="text-xl font-medium text-gray-700 mb-3">Experiment Details</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
            <p><strong>Description:</strong> <span class="text-gray-600"><%= experiment.description || 'N/A' %></span></p>
            <p><strong>Created By:</strong> <span class="text-gray-600"><%= experiment.created_by_admin_username || 'N/A' %></span></p>
            <p><strong>Start Date:</strong> <span class="text-gray-600"><%= experiment.start_date || 'N/A' %></span></p>
            <p><strong>End Date:</strong> <span class="text-gray-600"><%= experiment.end_date || 'N/A' %></span></p>
            <p><strong>TTL (s):</strong> <span class="text-gray-600"><%= experiment.ttl_seconds !== null && experiment.ttl_seconds !== undefined ? experiment.ttl_seconds : '∞' %></span></p>
            <p><strong>TTL Remaining (s):</strong> <span class="text-gray-600"><%= experiment.ttl_remaining !== null && experiment.ttl_remaining !== undefined ? Math.round(experiment.ttl_remaining) : '∞' %></span></p>
            <p><strong>Created At:</strong> <span class="text-gray-600"><%= experiment.created_at || 'N/A' %></span></p>
            <p><strong>Config Details:</strong> <pre class="text-gray-600 bg-gray-100 p-2 rounded text-xs max-h-40 overflow-y-auto"><%= experiment.config_details ? JSON.stringify(experiment.config_details, null, 2) : 'N/A' %></pre></p>
          </div>
        </div>
      </div>

      <div class="card bg-white rounded-lg shadow-elevation-1 mb-8">
        <div class="card-header py-5 px-6 border-b border-gray-200 flex justify-between items-center">
          <h2 class="text-xl font-medium text-gray-700">Participants in this Experiment (<%= participants ? participants.length : 0 %>)</h2>
          <div>
            <form action="/admin/experiments/<%= experiment.experiment_id %>/assign-participants" method="POST" class="inline mr-2">
              <button type="submit" class="btn btn-sm bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded text-xs">Auto Assign (5 Users)</button>
            </form>
            <form action="/admin/experiments/<%= experiment.experiment_id %>/drop-participants" method="POST" class="inline">
              <button type="submit" class="btn btn-sm bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded text-xs" onclick="return confirm('Are you sure you want to drop all participants from this experiment?');">Drop All</button>
            </form>
          </div>
        </div>
        <div class="card-content p-0">
          <div class="overflow-x-auto">
            <table class="data-table w-full min-w-max">
              <thead>
                <tr class="bg-gray-100 border-b border-gray-200">
                  <th class="py-3 px-4 text-left text-sm font-semibold text-gray-700">Firebase UID</th>
                  <th class="py-3 px-4 text-left text-sm font-semibold text-gray-700">Variant Assigned</th>
                  <th class="py-3 px-4 text-left text-sm font-semibold text-gray-700">Assigned At</th>
                  <th class="py-3 px-4 text-left text-sm font-semibold text-gray-700">Status in Experiment</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <% if (participants && participants.length > 0) { %>
                  <% participants.forEach(function(ptp) { %>
                    <tr class="hover:bg-gray-50 transition-colors">
                      <td class="py-3 px-4 text-sm text-gray-700"><%= ptp.firebase_uid %></td>
                      <td class="py-3 px-4 text-sm text-gray-700"><%= ptp.variant_assigned || 'N/A' %></td>
                      <td class="py-3 px-4 text-sm text-gray-700"><%= ptp.assigned_at || 'N/A' %></td>
                      <td class="py-3 px-4 text-sm text-gray-700"><%= ptp.status_in_experiment || 'N/A' %></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="4" class="text-center py-4 text-gray-500">No participants assigned to this experiment yet.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      
      <!-- Placeholder for actual results/interaction data section -->
      <div class="card bg-white rounded-lg shadow-elevation-1">
        <div class="card-header py-5 px-6 border-b border-gray-200">
          <h2 class="text-xl font-medium text-gray-700">Interaction Data / Actual Results (Coming Soon)</h2>
        </div>
        <div class="card-content p-6">
          <p class="text-gray-600">Detailed interaction logs and aggregated results for this experiment will be displayed here in a future update.</p>
        </div>
      </div>
    <% } else if (!error) { %>
      <div class="text-center py-10">
        <p class="text-xl text-gray-600">Experiment data not found or could not be loaded.</p>
      </div>
    <% } %>
  </main>

</div>

<script>
const menuToggle = document.getElementById('menu-toggle');
const sidebar = document.querySelector('.sidebar');
const mainContent = document.querySelector('.main-content');
menuToggle.addEventListener('click', () => {
    sidebar.classList.toggle('sidebar-hidden');
    mainContent.classList.toggle('main-content-full');
});
</script>

</body>
</html>
